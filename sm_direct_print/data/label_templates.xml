<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Label Template: 100mm x 50mm -->
    <record id="template_product_100x50" model="direct.print.label.template">
        <field name="name">Product Label (100×50mm)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="label_width">100</field>
        <field name="label_height">50</field>
        <field name="dpi">203</field>
        <field name="copies">1</field>
        <field name="darkness">15</field>
    </record>

    <!-- Product Name -->
    <record id="element_product_name" model="direct.print.label.element">
        <field name="template_id" ref="template_product_100x50"/>
        <field name="sequence">10</field>
        <field name="element_type">text</field>
        <field name="pos_x">3</field>
        <field name="pos_y">3</field>
        <field name="field_name">name</field>
        <field name="font_size">32</field>
    </record>

    <!-- Internal Reference -->
    <record id="element_product_code" model="direct.print.label.element">
        <field name="template_id" ref="template_product_100x50"/>
        <field name="sequence">20</field>
        <field name="element_type">text</field>
        <field name="pos_x">3</field>
        <field name="pos_y">10</field>
        <field name="field_name">default_code</field>
        <field name="font_size">24</field>
    </record>

    <!-- Separator Line -->
    <record id="element_product_line" model="direct.print.label.element">
        <field name="template_id" ref="template_product_100x50"/>
        <field name="sequence">25</field>
        <field name="element_type">line</field>
        <field name="pos_x">3</field>
        <field name="pos_y">16</field>
        <field name="line_width">94</field>
        <field name="line_thickness">2</field>
    </record>

    <!-- Barcode -->
    <record id="element_product_barcode" model="direct.print.label.element">
        <field name="template_id" ref="template_product_100x50"/>
        <field name="sequence">30</field>
        <field name="element_type">barcode</field>
        <field name="pos_x">15</field>
        <field name="pos_y">20</field>
        <field name="field_name">barcode</field>
        <field name="barcode_type">code128</field>
        <field name="barcode_height">60</field>
        <field name="barcode_show_text" eval="True"/>
    </record>

    <!-- Price -->
    <record id="element_product_price" model="direct.print.label.element">
        <field name="template_id" ref="template_product_100x50"/>
        <field name="sequence">40</field>
        <field name="element_type">text</field>
        <field name="pos_x">70</field>
        <field name="pos_y">3</field>
        <field name="field_name">list_price</field>
        <field name="static_text">$</field>
        <field name="font_size">36</field>
    </record>


    <!-- Small Product Label: 50mm x 25mm -->
    <record id="template_product_50x25" model="direct.print.label.template">
        <field name="name">Product Label Small (50×25mm)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="label_width">50</field>
        <field name="label_height">25</field>
        <field name="dpi">203</field>
        <field name="copies">1</field>
    </record>

    <record id="element_small_name" model="direct.print.label.element">
        <field name="template_id" ref="template_product_50x25"/>
        <field name="sequence">10</field>
        <field name="element_type">text</field>
        <field name="pos_x">2</field>
        <field name="pos_y">2</field>
        <field name="field_name">name</field>
        <field name="font_size">20</field>
    </record>

    <record id="element_small_barcode" model="direct.print.label.element">
        <field name="template_id" ref="template_product_50x25"/>
        <field name="sequence">20</field>
        <field name="element_type">barcode</field>
        <field name="pos_x">5</field>
        <field name="pos_y">9</field>
        <field name="field_name">barcode</field>
        <field name="barcode_type">code128_small</field>
        <field name="barcode_height">40</field>
        <field name="barcode_show_text" eval="True"/>
    </record>


    <!-- QR Code Label: 40mm x 40mm -->
    <record id="template_qr_40x40" model="direct.print.label.template">
        <field name="name">QR Code Label (40×40mm)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="label_width">40</field>
        <field name="label_height">40</field>
        <field name="dpi">203</field>
        <field name="copies">1</field>
    </record>

    <record id="element_qr_code" model="direct.print.label.element">
        <field name="template_id" ref="template_qr_40x40"/>
        <field name="sequence">10</field>
        <field name="element_type">qrcode</field>
        <field name="pos_x">5</field>
        <field name="pos_y">2</field>
        <field name="field_name">barcode</field>
        <field name="barcode_type">qrcode</field>
    </record>

    <record id="element_qr_name" model="direct.print.label.element">
        <field name="template_id" ref="template_qr_40x40"/>
        <field name="sequence">20</field>
        <field name="element_type">text</field>
        <field name="pos_x">2</field>
        <field name="pos_y">33</field>
        <field name="field_name">default_code</field>
        <field name="font_size">20</field>
    </record>


    <!-- ============================================ -->
    <!-- Shipping / Address Label: 100mm x 150mm      -->
    <!-- ============================================ -->
    <record id="template_shipping_100x150" model="direct.print.label.template">
        <field name="name">Shipping Label (100×150mm)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="label_width">100</field>
        <field name="label_height">150</field>
        <field name="dpi">203</field>
        <field name="copies">1</field>
        <field name="darkness">15</field>
    </record>

    <record id="element_ship_name" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">10</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">5</field>
        <field name="static_text">SHIP TO:</field>
        <field name="font_size">24</field>
    </record>

    <record id="element_ship_partner" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">20</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">12</field>
        <field name="field_name">name</field>
        <field name="font_size">36</field>
    </record>

    <record id="element_ship_street" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">30</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">22</field>
        <field name="field_name">street</field>
        <field name="font_size">28</field>
    </record>

    <record id="element_ship_city" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">40</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">32</field>
        <field name="field_name">city</field>
        <field name="font_size">28</field>
    </record>

    <record id="element_ship_zip" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">50</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">42</field>
        <field name="field_name">zip</field>
        <field name="font_size">32</field>
    </record>

    <record id="element_ship_line" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">55</field>
        <field name="element_type">line</field>
        <field name="pos_x">5</field>
        <field name="pos_y">52</field>
        <field name="line_width">90</field>
        <field name="line_thickness">3</field>
    </record>

    <record id="element_ship_phone" model="direct.print.label.element">
        <field name="template_id" ref="template_shipping_100x150"/>
        <field name="sequence">60</field>
        <field name="element_type">text</field>
        <field name="pos_x">5</field>
        <field name="pos_y">56</field>
        <field name="field_name">phone</field>
        <field name="static_text">Tel:</field>
        <field name="font_size">24</field>
    </record>

    <!-- ============================================ -->
    <!-- Receipt Header (ESC/POS example): 80mm       -->
    <!-- ============================================ -->
    <record id="template_receipt_80" model="direct.print.label.template">
        <field name="name">Receipt Header (80mm, ESC/POS)</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="label_width">80</field>
        <field name="label_height">60</field>
        <field name="dpi">203</field>
        <field name="copies">1</field>
    </record>

    <record id="element_receipt_company" model="direct.print.label.element">
        <field name="template_id" ref="template_receipt_80"/>
        <field name="sequence">10</field>
        <field name="element_type">text</field>
        <field name="pos_x">10</field>
        <field name="pos_y">5</field>
        <field name="field_name">name</field>
        <field name="font_size">36</field>
    </record>

    <record id="element_receipt_address" model="direct.print.label.element">
        <field name="template_id" ref="template_receipt_80"/>
        <field name="sequence">20</field>
        <field name="element_type">text</field>
        <field name="pos_x">10</field>
        <field name="pos_y">15</field>
        <field name="field_name">street</field>
        <field name="font_size">20</field>
    </record>

    <record id="element_receipt_phone" model="direct.print.label.element">
        <field name="template_id" ref="template_receipt_80"/>
        <field name="sequence">30</field>
        <field name="element_type">text</field>
        <field name="pos_x">10</field>
        <field name="pos_y">22</field>
        <field name="field_name">phone</field>
        <field name="font_size">20</field>
    </record>

</odoo>
