<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sm_direct_print.LabelPreview">
        <div class="o_label_preview p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">
                    <i class="fa fa-eye me-2"/> Label Preview
                </h3>
                <button class="btn btn-secondary" t-on-click="goBack">
                    <i class="fa fa-arrow-left me-1"/> Back
                </button>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-muted mb-3"/>
                <p class="text-muted">Rendering label via Labelary API...</p>
            </div>

            <!-- Error -->
            <div t-if="state.error" class="alert alert-warning">
                <i class="fa fa-exclamation-triangle me-1"/>
                <t t-esc="state.error"/>
                <p class="mt-2 mb-0 small text-muted">
                    Note: Preview requires internet access for the Labelary API.
                    The actual printing works offline.
                </p>
            </div>

            <!-- Preview Image -->
            <div t-if="state.imageData" class="text-center">
                <div class="card d-inline-block shadow-sm">
                    <div class="card-body p-3 bg-light">
                        <img t-att-src="state.imageData"
                             class="border"
                             style="max-width: 100%; image-rendering: pixelated;"
                             alt="Label Preview"/>
                    </div>
                </div>
                <p class="text-muted mt-2 small">
                    <i class="fa fa-info-circle me-1"/>
                    This is a rendering of the ZPL code. Actual printed output may vary slightly.
                </p>
            </div>
        </div>
    </t>

</templates>
