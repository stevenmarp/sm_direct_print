<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Label Template List View -->
    <record id="label_template_view_list" model="ir.ui.view">
        <field name="name">direct.print.label.template.list</field>
        <field name="model">direct.print.label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates">
                <field name="name"/>
                <field name="model_name"/>
                <field name="label_width"/>
                <field name="label_height"/>
                <field name="dpi"/>
                <field name="copies"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Label Template Form View -->
    <record id="label_template_view_form" model="ir.ui.view">
        <field name="name">direct.print.label.template.form</field>
        <field name="model">direct.print.label.template</field>
        <field name="arch" type="xml">
            <form string="Label Template">
                <header>
                    <button name="action_preview" type="object"
                            string="Preview Label" class="btn-primary"
                            icon="fa-eye"/>
                    <button name="action_print_test" type="object"
                            string="Print Test" class="btn-secondary"
                            icon="fa-print"/>
                </header>
                <sheet>
                    <group>
                        <group string="Template Info">
                            <field name="name" placeholder="e.g., Product Label 100x50"/>
                            <field name="model_id"
                                   options="{'no_create': True}"
                                   domain="[('model', 'in', ['product.product', 'product.template', 'stock.lot', 'stock.picking', 'account.move', 'sale.order', 'purchase.order', 'res.partner', 'res.company', 'stock.move.line', 'mrp.production'])]"/>
                            <field name="orientation"/>
                            <field name="active"/>
                        </group>
                        <group string="Label Size">
                            <field name="label_width"/>
                            <field name="label_height"/>
                            <field name="dpi"/>
                            <field name="copies"/>
                            <field name="darkness"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Label Elements" name="elements">
                            <field name="element_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="element_type"/>
                                    <field name="pos_x"/>
                                    <field name="pos_y"/>
                                    <field name="field_name" placeholder="name, default_code, barcode..."
                                           invisible="element_type in ('line', 'box', 'raw_zpl')"/>
                                    <field name="static_text" placeholder="Fixed text"
                                           invisible="element_type in ('line', 'box', 'raw_zpl')"/>
                                    <field name="font_size"
                                           invisible="element_type != 'text'"/>
                                    <field name="barcode_type"
                                           invisible="element_type not in ('barcode', 'qrcode')"/>
                                    <field name="barcode_height"
                                           invisible="element_type not in ('barcode', 'qrcode')"/>
                                    <field name="barcode_show_text"
                                           invisible="element_type not in ('barcode', 'qrcode')"/>
                                    <field name="line_width"
                                           invisible="element_type not in ('line', 'box')"/>
                                    <field name="line_height"
                                           invisible="element_type != 'box'"/>
                                    <field name="line_thickness"
                                           invisible="element_type not in ('line', 'box')"/>
                                </list>
                            </field>
                        </page>
                        <page string="ZPL Preview" name="zpl_preview">
                            <field name="zpl_preview" readonly="1" widget="ace"
                                   options="{'mode': 'text'}"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Label Element Form (for editing in dialog) -->
    <record id="label_element_view_form" model="ir.ui.view">
        <field name="name">direct.print.label.element.form</field>
        <field name="model">direct.print.label.element</field>
        <field name="arch" type="xml">
            <form string="Label Element">
                <group>
                    <group string="Position">
                        <field name="element_type"/>
                        <field name="sequence"/>
                        <field name="pos_x"/>
                        <field name="pos_y"/>
                    </group>
                    <group string="Content" invisible="element_type in ('line', 'box')">
                        <field name="field_name" invisible="element_type == 'raw_zpl'"/>
                        <field name="static_text" invisible="element_type == 'raw_zpl'"/>
                        <field name="raw_zpl" invisible="element_type != 'raw_zpl'"/>
                    </group>
                </group>
                <group>
                    <group string="Text Options" invisible="element_type != 'text'">
                        <field name="font_size"/>
                        <field name="font_width"/>
                        <field name="bold"/>
                        <field name="rotation"/>
                    </group>
                    <group string="Barcode Options" invisible="element_type not in ('barcode', 'qrcode')">
                        <field name="barcode_type"/>
                        <field name="barcode_height"/>
                        <field name="barcode_show_text"/>
                    </group>
                    <group string="Line/Box Options" invisible="element_type not in ('line', 'box')">
                        <field name="line_width"/>
                        <field name="line_height"/>
                        <field name="line_thickness"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Label Template Action -->
    <record id="label_template_action" model="ir.actions.act_window">
        <field name="name">Label Templates</field>
        <field name="res_model">direct.print.label.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first label template
            </p>
            <p>
                Design label layouts with text fields, barcodes, QR codes, and more.
                Use field names from any Odoo model to create dynamic labels.
            </p>
        </field>
    </record>

    <!-- Server Action: Print Labels (bindable to any model) -->
    <record id="action_direct_print_product" model="ir.actions.server">
        <field name="name">Print Labels</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Print Labels',
    'res_model': 'direct.print.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'active_model': 'product.product',
        'active_ids': records.ids,
    },
}
        </field>
    </record>

</odoo>
